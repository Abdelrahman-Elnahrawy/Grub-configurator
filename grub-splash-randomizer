#!/usr/bin/env bash
# ──────────────────────────────────────────────────────────────────────────────
# grub-splash-randomizer
# Picks a random Plymouth theme from favourites and sets it for the NEXT boot.
# Runs at SHUTDOWN so the chosen theme is ready when the machine next starts.
# ──────────────────────────────────────────────────────────────────────────────

set -euo pipefail

STATE_FILE="/etc/grub-configurator/state.json"
PLYMOUTH_THEMES_DIR="/usr/share/plymouth/themes"
THEMES_SYMLINK="$PLYMOUTH_THEMES_DIR/default.plymouth"
ALTERNATIVES_SYMLINK="/etc/alternatives/default.plymouth"
LOG_TAG="grub-splash-randomizer"

export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

log() { logger -t "$LOG_TAG" "$*" 2>/dev/null || echo "$LOG_TAG: $*" >&2; }

# ── 1. State file ─────────────────────────────────────────────────────────────
if [[ ! -f "$STATE_FILE" ]]; then
    log "State file not found — nothing to do."
    exit 0
fi

# ── 2. Parse favourites with python3 (handles multi-line JSON) ────────────────
mapfile -t favorites < <(
    python3 - "$STATE_FILE" <<'PYEOF'
import json, sys
try:
    data = json.load(open(sys.argv[1]))
    for f in data.get("splash_favorites", []):
        print(f)
except Exception:
    pass
PYEOF
)

if [[ ${#favorites[@]} -eq 0 ]]; then
    log "No favourites in state file — nothing to do."
    exit 0
fi

# ── 3. Filter to themes that exist on disk ────────────────────────────────────
valid=()
for theme in "${favorites[@]}"; do
    if [[ -d "$PLYMOUTH_THEMES_DIR/$theme" ]]; then
        valid+=("$theme")
    fi
done

if [[ ${#valid[@]} -eq 0 ]]; then
    log "None of the favourites exist on disk — nothing to do."
    exit 0
fi

# ── 4. Pick a random theme ────────────────────────────────────────────────────
chosen="${valid[$(( RANDOM % ${#valid[@]} ))]}"
log "Chose '$chosen' from ${#valid[@]} favourites."

# ── 5. Find the theme's .plymouth file ───────────────────────────────────────
theme_file="$PLYMOUTH_THEMES_DIR/$chosen/$chosen.plymouth"
if [[ ! -f "$theme_file" ]]; then
    theme_file="$(find "$PLYMOUTH_THEMES_DIR/$chosen" -name "*.plymouth" | head -1)"
fi
if [[ -z "$theme_file" || ! -f "$theme_file" ]]; then
    log "ERROR: No .plymouth file found for '$chosen'."
    exit 1
fi

# ── 6. Set the theme — update BOTH symlinks in the chain ─────────────────────
# Plymouth at boot follows: themes/default.plymouth -> /etc/alternatives/default.plymouth
#                                                    -> actual theme file
# Both must point to the chosen theme or one stale link breaks the chain.
ln -sf "$theme_file" "$ALTERNATIVES_SYMLINK"
ln -sf "$theme_file" "$THEMES_SYMLINK"
log "Symlinks set: $THEMES_SYMLINK -> $theme_file"
log "Symlinks set: $ALTERNATIVES_SYMLINK -> $theme_file"

# ── 7. Register with update-alternatives to keep system state consistent ──────
if command -v update-alternatives &>/dev/null; then
    # Register if not already known
    if ! update-alternatives --list default.plymouth 2>/dev/null | grep -qF "$theme_file"; then
        update-alternatives --install \
            "$THEMES_SYMLINK" default.plymouth "$theme_file" 60 || true
    fi
    update-alternatives --set default.plymouth "$theme_file" || true
fi

# ── 8. Rebuild initramfs so the change takes effect on next boot ──────────────
if command -v update-initramfs &>/dev/null; then
    log "Rebuilding initramfs..."
    update-initramfs -u -k "$(uname -r)"
    log "Done — '$chosen' will show on next boot."
elif command -v mkinitcpio &>/dev/null; then
    mkinitcpio -P
    log "Done — '$chosen' will show on next boot."
elif command -v dracut &>/dev/null; then
    dracut --force
    log "Done — '$chosen' will show on next boot."
else
    log "WARNING: No initramfs tool found — symlinks set but initramfs not rebuilt."
fi
